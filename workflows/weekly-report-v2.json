        "jsCode": "// Texto de Apps Script: ya viene escapado. Solo se blinda lo que Telegram rechazaria (nunca se re-escapa lo ya escapado).\nconst norm = (s) => String(s ?? '').replace(/&(?!(amp|lt|gt|quot|#\\d+);)/g, '&amp;').replace(/<(?!\\/?(b|i|u|s|code|pre)>|a href=\"[^\"]*\">|\\/a>)/g, '&lt;') || '(sin texto)';\nconst r = $input.first().json || {};\nreturn [{ json: { chatId: r.chatId, texto: norm(r.texto) } }];"
      },
