      "id": "88c4bc6c-c38a-4180-b794-af615558f0e5",
      "name": "¿Es nuestro número?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// T-046 · Basado en adaptar() de telegram-whatsapp-n8n/adaptador.js.\n// Los estados no generan items; reacciones y botones ajenos solo se copian al grupo.\nconst config = $('Config WA').first().json;\nconst permitidos = typeof config.permitidos === 'string' ? JSON.parse(config.permitidos) : config.permitidos;\nif (!Array.isArray(permitidos)) throw new Error('Config WA: permitidos debe ser una lista');\nconst CFG = {\n  phoneNumberId: config.phoneNumberId,\n  chatId: Number(config.chatId),\n  permitidos: permitidos.map(p => p.numero),\n  nombres: Object.fromEntries(permitidos.map(p => [p.numero, p.nombre])),\n  callbackOk: /^pc:[^:]+:[^:]+$/,\n};\nfunction adaptar(items, cfg) {\n  const out = [];\n  const vistos = new Set();\n  items.forEach((item, idx) => {\n    const raw = item.json.body || item.json;\n    // El WhatsApp Trigger entrega el \"value\" directo; un Webhook genérico entrega entry[].changes[].\n    const values = raw.entry\n      ? raw.entry.flatMap(e => (e.changes || []).filter(c => c.field === 'messages').map(c => c.value))\n      : [raw];\n    for (const v of values) {\n      const pid = v.metadata?.phone_number_id;\n      if (!pid || String(pid) !== String(cfg.phoneNumberId)) continue;\n      // Los avisos de estado (enviado, entregado, leído) llegan sin \"messages\": no producen nada.\n      for (const m of v.messages || []) {\n        if (!m.id || typeof m.type !== 'string' || typeof m.from !== 'string' || !m.from || vistos.has(m.id)) continue;\n        const wa = { from: m.from, wamid: m.id, tipo: m.type, context_id: m.context?.id || null };\n        wa.nombre = v.contacts?.find(c=>c.wa_id===m.from)?.profile?.name || '';\n        const msg = { message_id: m.id, date: Number(m.timestamp) || 0,\n                      chat: { id: cfg.chatId, type: 'private' }, from: { id: cfg.chatId } };\n        const update = { update_id: 'wa_' + m.id, canal: 'whatsapp', wa, message: msg };\n        // Meta solo manda el wamid del mensaje respondido; el texto se restaura desde la tabla wa_contexto.\n        if (wa.context_id) msg.reply_to_message = { message_id: wa.context_id, text: '' };\n        let soportado = true;\n        let ignorar = ['reaction', 'unsupported'].includes(m.type);\n        let dataBoton = '';\n        const media = m[m.type];\n        if (m.type === 'text' && typeof m.text?.body === 'string') msg.text = m.text.body;\n        else if (['audio', 'image', 'document'].includes(m.type) && media?.id) {\n          const mime = String(media.mime_type || '').split(';')[0].trim();\n          const f = { file_id: media.id, file_unique_id: media.sha256 || media.id, mime_type: mime };\n          wa.media_id = media.id; wa.mime_type = mime;\n          if (m.type === 'audio' && mime.startsWith('audio/')) msg.voice = f;\n          else if (m.type === 'image' && mime.startsWith('image/')) msg.photo = [f];\n          else if (m.type === 'document' && /^(image\\/|application\\/pdf$)/.test(mime))\n            msg.document = { ...f, file_name: media.filename || '' };\n          else soportado = false;\n          if (media.caption) msg.caption = media.caption;\n        } else if (m.type === 'interactive') {\n          dataBoton = m.interactive?.button_reply?.id || m.interactive?.list_reply?.id || '';\n          if (!cfg.callbackOk.test(dataBoton) || !wa.context_id) {\n            ignorar = true;\n            soportado = false;\n          } else {\n            delete update.message;\n            update.callback_query = { id: m.id, from: { id: cfg.chatId }, data: dataBoton,\n                                      message: { ...msg, message_id: wa.context_id, text: '' } };\n          }\n        } else soportado = false;\n        const autorizado = cfg.permitidos.includes(m.from);\n        const nombre = wa.nombre || cfg.nombres[m.from] || 'Desconocido';\n        const esc = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n        let aviso;\n        if (m.type === 'text') aviso = m.text?.body || '';\n        else if (m.type === 'interactive') aviso = '[botón] ' + dataBoton;\n        else {\n          const etiqueta = { image: 'foto', audio: 'audio', document: 'PDF/documento', sticker: 'sticker' }[m.type] || m.type;\n          aviso = '[' + etiqueta + ']';\n          if (media?.caption) aviso += ' ' + media.caption;\n          if (media?.filename) aviso += ' ' + media.filename;\n        }\n        // El único <b> es fijo y ya queda cerrado antes de cualquier dato variable.\n        // Recortar por tokens escapados conserva entidades y pares Unicode completos.\n        let textoGrupo = '📲 <b>WhatsApp</b> · ';\n        const contenidoGrupo = esc(nombre) + ' (+' + esc(m.from) + ')\\n' + esc(aviso)\n          + (autorizado ? '' : '\\n(no autorizado)');\n        for (const [token] of contenidoGrupo.matchAll(/&(?:amp|lt|gt);|[\\s\\S]/gu)) {\n          if (textoGrupo.length + token.length > 4000) break;\n          textoGrupo += token;\n        }\n        vistos.add(m.id);\n        out.push({ json: { update, soportado, autorizado, ignorar, from: m.from, nombre, tipo: m.type, wamid: m.id, textoGrupo },\n                   pairedItem: { item: idx } });\n      }\n    }\n  });\n  return out;\n}\n\nreturn adaptar($input.all(), CFG);"
      },
