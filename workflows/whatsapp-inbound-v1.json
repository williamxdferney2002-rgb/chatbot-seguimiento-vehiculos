    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Conservar pairedItem para borrar por el id original de Leer pendientes.\n// El subflujo recibe solo su contrato de envío, sin columnas internas.\nconst vistos = new Set();\nconst out = [];\nfor (const [index, item] of $input.all().entries()) {\n  const r = item.json || {};\n  if (!Number.isSafeInteger(Number(r.id)) || Number(r.id) <= 0 ||\n      typeof r.destino !== 'string' || !r.destino.trim() || typeof r.texto !== 'string' || !r.texto.trim()) {\n    continue; // Una fila inválida no bloquea los demás pendientes.\n  }\n  if (vistos.has(String(r.id))) continue;\n  vistos.add(String(r.id));\n  out.push({ json: { canal: 'whatsapp', destino: r.destino, texto: r.texto, botones: [] }, pairedItem: { item: index } });\n}\nreturn out;"
      },
